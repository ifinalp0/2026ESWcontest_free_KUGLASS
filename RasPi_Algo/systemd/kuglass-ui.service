[Unit]
Description=KUGLASS UI/API service
After=kuglass-control.service

[Service]
Type=simple
WorkingDirectory=/opt/kuglass/RasPi_Algo
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kuglass/RasPi_Algo/.venv/bin/python -m kuglass.ui_service --config config/config.yaml --host 0.0.0.0 --port 8080
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

